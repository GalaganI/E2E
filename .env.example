# Copy to .env to override defaults. Every value below is a non-secret local default;
# the framework works without a .env file.

# Application under test (public demo shop)
BASE_URL=https://automationexercise.com

# Local simulated services (started automatically by Playwright `webServer`)
PAYMENT_SERVICE_URL=http://127.0.0.1:4010
CALENDAR_SERVICE_URL=http://127.0.0.1:4020
MAILPIT_URL=http://127.0.0.1:8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

# Local service credentials (test-only values, NOT real secrets)
PAYMENT_API_KEY=sk_test_local_payments
PAYMENT_READONLY_KEY=rk_test_local_payments
WEBHOOK_SIGNING_SECRET=whsec_test_local
CALENDAR_API_TOKEN=cal_test_local_token

# Delay (ms) before the payment simulator confirms a "delayed" card payment
PAYMENT_CONFIRMATION_DELAY_MS=1500

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Set to true to also run UI tests in Firefox and WebKit (browsers must be installed)
CROSS_BROWSER=false
